# ========================================================
# AI Travel Agent - Production .gitignore
# ========================================================

# --------------------------------------------------------
# Environment variables & API keys (Never commit secrets!)
# --------------------------------------------------------
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
backend/.env.local
frontend/.env.local

# --------------------------------------------------------
# Node.js & Frontend Build Outputs
# --------------------------------------------------------
node_modules/
frontend/node_modules/
**/node_modules/
dist/
frontend/dist/
**/dist/
build/
frontend/build/
.vite/
frontend/.vite/
**/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------------------
# Python, Virtual Environments & Bytecode
# --------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
backend/venv/
backend/.venv/
env/
.env/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --------------------------------------------------------
# Testing, Coverage & Caches
# --------------------------------------------------------
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.cache

# --------------------------------------------------------
# Operating System & IDE Files
# --------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --------------------------------------------------------
# Database, Local Temp & Log Files
# --------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
tmp/
temp/