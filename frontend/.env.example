# ========================================================
# AI Travel Agent - Frontend Environment Variables
# ========================================================

# Base API URL:
# For local development: http://localhost:8000/api (or leave commented out for Vite proxy)
# For production (Render.com free web service): https://your-backend-name.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# ========================================================
# Firebase Authentication (Google Sign-In)
# ========================================================
# 1. Go to https://console.firebase.google.com/ and create a free project.
# 2. In Project Settings -> General -> "Your apps", add a Web App to get these keys.
# 3. In "Build" -> "Authentication" -> "Sign-in method", enable "Google".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
