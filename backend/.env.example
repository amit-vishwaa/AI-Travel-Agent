# ========================================================
# AI Travel Agent - Backend Environment Variables
# ========================================================

# ========================================================
# Database: MongoDB Atlas Cloud (Free M0 Sandbox) or Local
# ========================================================
# For MongoDB Atlas Cloud:
# 1. Sign up for free at https://www.mongodb.com/cloud/atlas
# 2. In "Network Access", add IP Address: 0.0.0.0/0 (Allow from anywhere)
# 3. In "Database Access", create a database user with username and password
# 4. Copy connection string (format below, replace <username> and <password>):
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/ai_travel_agent?retryWrites=true&w=majority
#
# For Local MongoDB:
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ai_travel_agent

# JWT Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI Provider: Google Gemini (100% Free on https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Weather & Navigation APIs (Free tiers available)
# OpenWeatherMap: https://openweathermap.org/api (1,000 calls/day free)
OPENWEATHER_API_KEY=
# OpenRouteService: https://openrouteservice.org/ (2,000 req/day free)
OPENROUTESERVICE_API_KEY=
# Optional flight search
SERPAPI_API_KEY=

# Local Ollama Fallback (Optional for local offline use)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cache & Timeouts
AI_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=900

# CORS Origins (Comma-separated origins, or * for public access)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
